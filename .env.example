# Supabase — from your project's API settings (or `pnpm supabase start` for local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the app is reachable. Used to build the Screen / OBS links an operator
# copies to another machine, and the OAuth redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstream scripture API. Proxied and cached server-side; never called from the browser.
BIBLE_API_URL=https://holybible.ge/service.php

# Stripe (subscriptions scaffold — gates are not enforced yet)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=

# Flip to 1 to start enforcing plan limits. Off while we shape the tiers.
NEXT_PUBLIC_ENFORCE_GATES=0
